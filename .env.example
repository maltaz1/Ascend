# Copie para .env.local e preencha. Nunca versione o arquivo com valores.
#
# ── Front-end (Vite) ─────────────────────────────────────────────
# Tudo com prefixo VITE_ vai para o navegador. Só valores PÚBLICOS aqui.
VITE_SUPABASE_URL=https://SEU-PROJETO.supabase.co
# Chave anon/publishable (pública; quem protege os dados é o RLS).
VITE_SUPABASE_ANON_KEY=
VITE_CAKTO_CHECKOUT_URL=
# Cloudflare Turnstile (CAPTCHA). Chave do SITE, pública. Sem ela o widget não aparece.
VITE_TURNSTILE_SITE_KEY=

# ── Servidor (funções da Vercel em /api) ─────────────────────────
# SEGREDOS: configure no painel da Vercel. NUNCA com prefixo VITE_.
SUPABASE_URL=https://SEU-PROJETO.supabase.co
SUPABASE_SERVICE_ROLE_KEY=
# Segredo de assinatura do webhook da Cakto (HMAC-SHA256).
CAKTO_WEBHOOK_SECRET=
# Valor do header Authorization configurado no webhook do RevenueCat.
REVENUECAT_WEBHOOK_AUTH=
# Chave secreta da API REST do RevenueCat (sk_...).
REVENUECAT_SECRET_API_KEY=
REVENUECAT_PRO_ENTITLEMENT=pro

# ── Edge Functions do Supabase ───────────────────────────────────
# Configure em Supabase > Edge Functions > Secrets (não ficam aqui).
# RESEND_API_KEY, WAITLIST_ADMIN_KEY, WAITLIST_FROM, SITE_URL,
# CANCELLATION_NOTIFY_TO
