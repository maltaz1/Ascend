{
  "expo": {
    "name": "Ascend",
    "slug": "ascend-mobile",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.ascendprod.app"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#12111a",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.ascendprod.app"
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-sqlite",
      "expo-font",
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-logo.png",
          "imageWidth": 220,
          "resizeMode": "contain",
          "backgroundColor": "#0f0c1f"
        }
      ]
    ],
    "scheme": "ascend",
    "experiments": {
      "typedRoutes": true
    },
    "backgroundColor": "#12111a",
    "owner": "ascendprod",
    "extra": {
      "router": {
        "asyncRoutes": {
          "web": true
        }
      },
      "eas": {
        "projectId": "1a3b3a9b-5fa0-47a0-8e1e-37b9397cde85"
      }
    }
  }
}
