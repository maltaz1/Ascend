# Copie para .env.local e preencha (os mesmos valores das VITE_ do web).
# São chaves públicas — nunca coloque aqui a service_role ou segredos.
EXPO_PUBLIC_SUPABASE_URL=https://SEU-PROJETO.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=
# Endereço do site (termos, privacidade e e-mails de confirmação/recuperação de senha).
EXPO_PUBLIC_WEB_URL=https://seu-dominio.com
# Checkout do Ascend PRO (o mesmo VITE_CAKTO_CHECKOUT_URL do web).
EXPO_PUBLIC_CAKTO_CHECKOUT_URL=
